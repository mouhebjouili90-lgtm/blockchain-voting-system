# Configuration pour déploiement sur le réseau public de test Sepolia

# URL RPC Sepolia (par défaut public, ou mettez votre clé Alchemy : https://eth-sepolia.g.alchemy.com/v2/VOTRE_CLE)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Votre clé privée MetaMask (celle du compte qui détient un peu de Sepolia ETH)
# ATTENTION : Ne partagez jamais votre clé privée. Le fichier .env est ignoré par Git.
PRIVATE_KEY=
